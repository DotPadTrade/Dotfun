# ==============================================================================
# RelayPad environment configuration
# Copy to .env.local and fill in values. NEVER commit real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Solana network & RPC
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_RELAYPAD_NETWORK: "devnet" | "mainnet-beta"
#   Controls which network the client connects to and which program IDs are used.
NEXT_PUBLIC_RELAYPAD_NETWORK=devnet

# Public RPC endpoint used by the browser client. Use your own provider for
# production (Helius, QuickNode, Triton, etc.). Leave empty to use the
# Solana public cluster endpoint (heavily rate-limited).
NEXT_PUBLIC_SOLANA_RPC_URL=

# Server-side RPC endpoint used for on-chain reconciliation / verification.
# Should be a paid, rate-limit-friendly endpoint. Defaults to the public one.
SOLANA_RPC_URL=

# ------------------------------------------------------------------------------
# Browser RPC (wallet connection + launch flow — client-side)
# ------------------------------------------------------------------------------
# Recommended: RelayPad's built-in server-side proxy, "/api/rpc". It forwards
# browser JSON-RPC to ALCHEMY_SOLANA_RPC_URL server-side with a strict method
# allowlist — the API key never reaches the browser, and signing stays in the
# wallet. Any dedicated browser-safe RPC URL can also be used here.
# SECURITY: never put a credentialed URL in a NEXT_PUBLIC_* variable —
# NEXT_PUBLIC_* values are inlined into the browser bundle.
NEXT_PUBLIC_SOLANA_RPC_URL=/api/rpc

# ------------------------------------------------------------------------------
# Alchemy — dedicated Solana RPC provider (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Precedence for server-side reads (discovery, reconcile, tx confirmation):
#   ALCHEMY_SOLANA_RPC_URL  →  SOLANA_RPC_URL  →  public cluster endpoint
# If ALCHEMY_SOLANA_RPC_URL is empty but ALCHEMY_API_KEY is set, the URL is
# derived automatically: https://solana-devnet.g.alchemy.com/v2/<key>
# NEVER reference these through NEXT_PUBLIC_* variables — NEXT_PUBLIC_* values
# are inlined into the browser bundle and would leak the key. Client wallet
# connections intentionally keep using NEXT_PUBLIC_SOLANA_RPC_URL (keyless).
ALCHEMY_API_KEY=
ALCHEMY_SOLANA_RPC_URL=
ALCHEMY_SOLANA_WS_URL=

# ------------------------------------------------------------------------------
# Database (PostgreSQL + Prisma)
# ------------------------------------------------------------------------------
# Standard Postgres connection string. Launch records, lifecycle state and
# upload audit rows are persisted here. On-chain state remains the source of
# truth for graduation / pool status; the DB only stores what RelayPad observed.
DATABASE_URL=postgresql://relaypad:CHANGE_ME@localhost:5432/relaypad?schema=public
# Dedicated connection string for the PostgreSQL provider package
# (prisma/postgres/schema.prisma). Local SQLite development keeps using
# DATABASE_URL; the two variables never collide. See prisma/postgres/README.md.
POSTGRES_DATABASE_URL=postgresql://relaypad:CHANGE_ME@localhost:5432/relaypad?schema=public

# ------------------------------------------------------------------------------
# Metadata / artwork upload (server-side only — credentials never reach client)
# ------------------------------------------------------------------------------
# RelayPad uploads artwork and metadata JSON to IPFS through Pinata.
# Create a JWT at https://app.pinata.cloud/ (Account > API Keys).
# Leave empty in development to run without upload capability — the API will
# return a clear configuration error instead of accepting uploads.
PINATA_JWT=
# Optional: dedicated gateway host used to display uploaded assets.
PINATA_GATEWAY=ipfs.io
# Max artwork upload size in bytes (default 10 MB).
UPLOAD_MAX_BYTES=10485760

# ------------------------------------------------------------------------------
# App
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=RelayPad
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Official $RELAY treasury dashboard (SERVER-SIDE ONLY — public data)
# ------------------------------------------------------------------------------
# Public addresses and non-secret configuration for the read-only /treasury
# dashboard. All values are PLACEHOLDERS until the owner finalizes them; unset
# values render honest "configuration needed" states on the dashboard.
# NEVER put private keys, seed phrases, or signing credentials in this file or
# any NEXT_PUBLIC_* variable — public addresses only.
# See docs/RELAY_OFFICIAL_TOKEN_BUYBACK_IMPLEMENTATION_PLAN.md.
RELAY_OFFICIAL_ENABLED=
# Network override; falls back to NEXT_PUBLIC_RELAYPAD_NETWORK when unset.
RELAY_OFFICIAL_NETWORK=
# W1 — official $RELAY creator-fee receiver (permanent fee recipient).
RELAY_OFFICIAL_CREATOR_WALLET=
# W2 — dedicated buyback treasury.
RELAY_OFFICIAL_BUYBACK_TREASURY=
# W3 — operations & reserve treasury.
RELAY_OFFICIAL_OPS_TREASURY=
# W4 — separate development wallet (transparency listing only).
RELAY_OFFICIAL_DEV_WALLET=
# Official $RELAY mint address (after launch; verified on-chain).
RELAY_OFFICIAL_MINT=
